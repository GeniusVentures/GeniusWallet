diff --git a/webview_all_linux/linux/src/webview/webkit_compat.h b/webview_all_linux/linux/src/webview/webkit_compat.h
new file mode 100644
index 0000000..b7bef6b
--- /dev/null
+++ b/webview_all_linux/linux/src/webview/webkit_compat.h
@@ -0,0 +1,119 @@
+#ifndef WEBVIEW_ALL_LINUX_WEBKIT_COMPAT_H_
+#define WEBVIEW_ALL_LINUX_WEBKIT_COMPAT_H_
+
+// Shims that let the plugin build against webkit2gtk-4.0 (WebKitGTK < 2.40,
+// libsoup 2.x, GLib < 2.66), as shipped by Ubuntu 20.04 and RHEL 8. With
+// webkit2gtk-4.1 every shim below compiles out.
+
+#include <libsoup/soup.h>
+#include <webkit2/webkit2.h>
+
+#if !WEBKIT_CHECK_VERSION(2, 40, 0)
+inline void webkit_web_view_evaluate_javascript(
+    WebKitWebView *web_view, const gchar *script, gssize, const gchar *,
+    const gchar *, GCancellable *cancellable, GAsyncReadyCallback callback,
+    gpointer user_data) {
+  webkit_web_view_run_javascript(web_view, script, cancellable, callback,
+                                 user_data);
+}
+
+inline JSCValue *webkit_web_view_evaluate_javascript_finish(
+    WebKitWebView *web_view, GAsyncResult *result, GError **error) {
+  WebKitJavascriptResult *js_result =
+      webkit_web_view_run_javascript_finish(web_view, result, error);
+  if (js_result == nullptr) {
+    return nullptr;
+  }
+  JSCValue *value = JSC_VALUE(
+      g_object_ref(webkit_javascript_result_get_js_value(js_result)));
+  webkit_javascript_result_unref(js_result);
+  return value;
+}
+#endif
+
+#if !SOUP_CHECK_VERSION(3, 0, 0)
+inline SoupStatus soup_message_get_status(SoupMessage *message) {
+  return static_cast<SoupStatus>(message->status_code);
+}
+
+inline const gchar *soup_message_get_method(SoupMessage *message) {
+  return message->method;
+}
+
+inline SoupMessageHeaders *soup_message_get_request_headers(
+    SoupMessage *message) {
+  return message->request_headers;
+}
+
+inline SoupMessageHeaders *soup_message_get_response_headers(
+    SoupMessage *message) {
+  return message->response_headers;
+}
+
+inline void soup_message_set_request_body_from_bytes(SoupMessage *message,
+                                                     const gchar *content_type,
+                                                     GBytes *bytes) {
+  gsize size = 0;
+  gconstpointer data = g_bytes_get_data(bytes, &size);
+  soup_message_set_request(message, content_type, SOUP_MEMORY_COPY,
+                           static_cast<const char *>(data), size);
+}
+
+inline void webkit_compat_queue_message_cb(SoupSession *, SoupMessage *message,
+                                           gpointer user_data) {
+  GTask *task = G_TASK(user_data);
+  if (SOUP_STATUS_IS_TRANSPORT_ERROR(message->status_code)) {
+    g_task_return_new_error(task, G_IO_ERROR, G_IO_ERROR_FAILED, "%s",
+                            message->reason_phrase != nullptr
+                                ? message->reason_phrase
+                                : "Transport error");
+  } else {
+    SoupBuffer *buffer = soup_message_body_flatten(message->response_body);
+    g_task_return_pointer(task, soup_buffer_get_as_bytes(buffer),
+                          reinterpret_cast<GDestroyNotify>(g_bytes_unref));
+    soup_buffer_free(buffer);
+  }
+  g_object_unref(task);
+}
+
+inline void soup_session_send_and_read_async(SoupSession *session,
+                                             SoupMessage *message, int,
+                                             GCancellable *cancellable,
+                                             GAsyncReadyCallback callback,
+                                             gpointer user_data) {
+  GTask *task = g_task_new(session, cancellable, callback, user_data);
+  // soup_session_queue_message() takes ownership of one reference.
+  soup_session_queue_message(session, SOUP_MESSAGE(g_object_ref(message)),
+                             webkit_compat_queue_message_cb, task);
+}
+
+inline GBytes *soup_session_send_and_read_finish(SoupSession *,
+                                                 GAsyncResult *result,
+                                                 GError **error) {
+  return static_cast<GBytes *>(
+      g_task_propagate_pointer(G_TASK(result), error));
+}
+#endif
+
+// GUri arrived in GLib 2.66; older GLib always pairs with libsoup 2.
+inline gchar *webkit_compat_uri_host(const gchar *uri_string) {
+#if GLIB_CHECK_VERSION(2, 66, 0)
+  GUri *uri = g_uri_parse(uri_string, G_URI_FLAGS_NONE, nullptr);
+  if (uri == nullptr) {
+    return nullptr;
+  }
+  gchar *host = g_strdup(g_uri_get_host(uri));
+  g_uri_unref(uri);
+  return host;
+#else
+  SoupURI *uri = soup_uri_new(uri_string);
+  if (uri == nullptr) {
+    return nullptr;
+  }
+  gchar *host = g_strdup(soup_uri_get_host(uri));
+  soup_uri_free(uri);
+  return host;
+#endif
+}
+
+#endif // WEBVIEW_ALL_LINUX_WEBKIT_COMPAT_H_
