    "version": "0.2.0",
    "configurations": [

        {
            "name": "GeniusWallet",
            "request": "launch",
            "type": "dart",
            "env": {
                "CMAKE_ARGUMENTS": "-DCMAKE_BUILD_TYPE=Debug -DGENIUS_DEPENDENCY_BRANCH=TestNet-Phase-3.1 -DBRANCH_IS_TAG=ON",
            }
        },
        {
            "name": "GeniusWallet (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "env": {
                "CMAKE_ARGUMENTS": "-DCMAKE_BUILD_TYPE=Release -DGENIUS_DEPENDENCY_BRANCH=TestNet-Phase-3.1 -DBRANCH_IS_TAG=ON",
            }
        },
        {
            "name": "GeniusWallet (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "env": {
                "CMAKE_ARGUMENTS": "-DCMAKE_BUILD_TYPE=Release -DGENIUS_DEPENDENCY_BRANCH=TestNet-Phase-3.1 -DBRANCH_IS_TAG=ON",
            }
        },
    ]
}