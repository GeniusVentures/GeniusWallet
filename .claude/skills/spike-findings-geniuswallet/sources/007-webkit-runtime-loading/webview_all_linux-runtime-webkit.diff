+  void (*run_javascript)(WebKitWebView *, const gchar *, GCancellable *,
+                         GAsyncReadyCallback, gpointer);
+  WebKitJavascriptResult *(*run_javascript_finish)(WebKitWebView *,
+                                                   GAsyncResult *, GError **);
+  void (*javascript_result_unref)(WebKitJavascriptResult *);
+
+  // libsoup 3 (webkit2gtk-4.1). SoupMessage is opaque there.
+  guint (*soup3_message_get_status)(SoupMessage *);
+  const char *(*soup3_message_get_method)(SoupMessage *);
+  SoupMessageHeaders *(*soup3_message_get_request_headers)(SoupMessage *);
+  SoupMessageHeaders *(*soup3_message_get_response_headers)(SoupMessage *);
+  void (*soup3_message_set_request_body_from_bytes)(SoupMessage *,
+                                                    const char *, GBytes *);
+  void (*soup3_session_send_and_read_async)(SoupSession *, SoupMessage *, int,
+                                            GCancellable *,
+                                            GAsyncReadyCallback, gpointer);
+  GBytes *(*soup3_session_send_and_read_finish)(SoupSession *, GAsyncResult *,
+                                                GError **);
+
+  // GLib >= 2.66 (GUri); always present alongside libsoup 3.
+  gpointer (*g_uri_parse)(const gchar *, guint, GError **);
+  const gchar *(*g_uri_get_host)(gpointer);
+  void (*g_uri_unref)(gpointer);
+};
