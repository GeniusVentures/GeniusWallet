+// libsoup 2 only (webkit2gtk-4.0); required when libsoup 3 is absent.
+#define GW_WEBKIT_SOUP2(X)                                                     \
+  X(soup_buffer_free)                                                          \
+  X(soup_buffer_get_as_bytes)                                                  \
+  X(soup_message_body_flatten)                                                 \
