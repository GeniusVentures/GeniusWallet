+#define GW_WEBKIT_FIELD(name) decltype(&::name) name;
+
+// Symbols that differ by WebKit or libsoup version are typed by hand: the
+// build headers (webkit2gtk-4.0, libsoup 2) may not declare them.
+struct GwWebKitApi {
+  GW_WEBKIT_REQUIRED(GW_WEBKIT_FIELD)
+  GW_WEBKIT_SOUP2(GW_WEBKIT_FIELD)
+
+  // WebKitGTK >= 2.40.
+  void (*evaluate_javascript)(WebKitWebView *, const gchar *, gssize,
+                              const gchar *, const gchar *, GCancellable *,
+                              GAsyncReadyCallback, gpointer);
+  JSCValue *(*evaluate_javascript_finish)(WebKitWebView *, GAsyncResult *,
+                                          GError **);
