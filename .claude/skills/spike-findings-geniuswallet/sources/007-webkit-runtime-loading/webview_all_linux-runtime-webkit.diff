+                    : message->response_headers;
+}
+
+inline void soup_message_set_request_body_from_bytes(SoupMessage *message,
+                                                     const gchar *content_type,
+                                                     GBytes *bytes) {
+  if (gw_soup3()) {
+    gw_webkit.soup3_message_set_request_body_from_bytes(message, content_type,
+                                                        bytes);
+    return;
+  }
+  gsize size = 0;
+  gconstpointer data = g_bytes_get_data(bytes, &size);
+  gw_webkit.soup_message_set_request(message, content_type, SOUP_MEMORY_COPY,
+                                     static_cast<const char *>(data), size);
+}
+
+inline void webkit_runtime_soup2_queue_cb(SoupSession *, SoupMessage *message,
+                                          gpointer user_data) {
+  GTask *task = G_TASK(user_data);
+  if (SOUP_STATUS_IS_TRANSPORT_ERROR(message->status_code)) {
+    g_task_return_new_error(task, G_IO_ERROR, G_IO_ERROR_FAILED, "%s",
+                            message->reason_phrase != nullptr
+                                ? message->reason_phrase
+                                : "Transport error");
+  } else {
+    SoupBuffer *buffer =
+        gw_webkit.soup_message_body_flatten(message->response_body);
+    g_task_return_pointer(task, gw_webkit.soup_buffer_get_as_bytes(buffer),
+                          reinterpret_cast<GDestroyNotify>(g_bytes_unref));
+    gw_webkit.soup_buffer_free(buffer);
+  }
+  g_object_unref(task);
+}
+
+inline void soup_session_send_and_read_async(SoupSession *session,
+                                             SoupMessage *message,
+                                             int io_priority,
+                                             GCancellable *cancellable,
+                                             GAsyncReadyCallback callback,
+                                             gpointer user_data) {
+  if (gw_soup3()) {
+    gw_webkit.soup3_session_send_and_read_async(
+        session, message, io_priority, cancellable, callback, user_data);
+    return;
+  }
+  GTask *task = g_task_new(session, cancellable, callback, user_data);
+  // soup_session_queue_message() takes ownership of one reference.
+  gw_webkit.soup_session_queue_message(
+      session, SOUP_MESSAGE(g_object_ref(message)),
+      webkit_runtime_soup2_queue_cb, task);
+}
+
+inline GBytes *soup_session_send_and_read_finish(SoupSession *session,
+                                                 GAsyncResult *result,
+                                                 GError **error) {
+  if (gw_soup3()) {
+    return gw_webkit.soup3_session_send_and_read_finish(session, result,
+                                                        error);
+  }
+  return static_cast<GBytes *>(
+      g_task_propagate_pointer(G_TASK(result), error));
+}
+
+inline gchar *webkit_compat_uri_host(const gchar *uri_string) {
+  gchar *host = nullptr;
+  if (gw_webkit.g_uri_parse != nullptr) {
+    gpointer uri = gw_webkit.g_uri_parse(uri_string, 0, nullptr);
+    if (uri != nullptr) {
+      host = g_strdup(gw_webkit.g_uri_get_host(uri));
+      gw_webkit.g_uri_unref(uri);
+    }
+    return host;
+  }
+  SoupURI *uri = gw_webkit.soup_uri_new(uri_string);
+  if (uri != nullptr) {
+    host = g_strdup(gw_webkit.soup_uri_get_host(uri));
+    gw_webkit.soup_uri_free(uri);
+  }
+  return host;
+}
