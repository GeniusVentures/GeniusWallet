+// Version-dependent calls, chosen by which symbols the loaded library has.
+
+inline gboolean gw_soup3() {
+  return gw_webkit.soup3_message_get_status != nullptr;
+}
+
+inline void webkit_web_view_evaluate_javascript_rt(
+    WebKitWebView *web_view, const gchar *script, gssize length,
+    const gchar *world_name, const gchar *source_uri,
+    GCancellable *cancellable, GAsyncReadyCallback callback,
+    gpointer user_data) {
+  if (gw_webkit.evaluate_javascript != nullptr) {
+    gw_webkit.evaluate_javascript(web_view, script, length, world_name,
+                                  source_uri, cancellable, callback,
+                                  user_data);
+    return;
+  }
+  gw_webkit.run_javascript(web_view, script, cancellable, callback, user_data);
+}
+
+inline JSCValue *webkit_web_view_evaluate_javascript_finish_rt(
+    WebKitWebView *web_view, GAsyncResult *result, GError **error) {
+  if (gw_webkit.evaluate_javascript_finish != nullptr) {
+    return gw_webkit.evaluate_javascript_finish(web_view, result, error);
+  }
+  WebKitJavascriptResult *js_result =
+      gw_webkit.run_javascript_finish(web_view, result, error);
+  if (js_result == nullptr) {
+    return nullptr;
+  }
+  JSCValue *value = JSC_VALUE(
+      g_object_ref(webkit_javascript_result_get_js_value(js_result)));
+  gw_webkit.javascript_result_unref(js_result);
+  return value;
+}
+
+#define webkit_web_view_evaluate_javascript webkit_web_view_evaluate_javascript_rt
+#define webkit_web_view_evaluate_javascript_finish                             \
+  webkit_web_view_evaluate_javascript_finish_rt
+
+inline SoupStatus soup_message_get_status(SoupMessage *message) {
+  if (gw_soup3()) {
+    return static_cast<SoupStatus>(gw_webkit.soup3_message_get_status(message));
+  }
+  return static_cast<SoupStatus>(message->status_code);
+}
+
+inline const gchar *soup_message_get_method(SoupMessage *message) {
+  return gw_soup3() ? gw_webkit.soup3_message_get_method(message)
+                    : message->method;
+}
+
+inline SoupMessageHeaders *soup_message_get_request_headers(
+    SoupMessage *message) {
+  return gw_soup3() ? gw_webkit.soup3_message_get_request_headers(message)
+                    : message->request_headers;
+}
+
+inline SoupMessageHeaders *soup_message_get_response_headers(
+    SoupMessage *message) {
