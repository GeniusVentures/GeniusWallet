+#define jsc_value_to_boolean (gw_webkit.jsc_value_to_boolean)
+#define jsc_value_to_double (gw_webkit.jsc_value_to_double)
+#define jsc_value_to_json (gw_webkit.jsc_value_to_json)
+#define jsc_value_to_string (gw_webkit.jsc_value_to_string)
+#define soup_cookie_free (gw_webkit.soup_cookie_free)
+#define soup_cookie_get_domain (gw_webkit.soup_cookie_get_domain)
+#define soup_cookie_get_name (gw_webkit.soup_cookie_get_name)
