+
+#ifndef GW_WEBKIT_NO_REDIRECT
+#define jsc_value_get_type (gw_webkit.jsc_value_get_type)
+#define jsc_value_is_boolean (gw_webkit.jsc_value_is_boolean)
+#define jsc_value_is_null (gw_webkit.jsc_value_is_null)
